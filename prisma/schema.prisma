generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  role         UserRole   @default(STUDENT)
  googleId     String?    @unique
  picture      String?
  title        String?
  faculty      String?
  program      String?
  department   String?
  stdCode      String?
  empCode      String?
  centralHours Int        @default(0)
  facultyHours Int        @default(0)
  freeHours    Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?  @default(now()) @updatedAt @db.Timestamptz(6)
  activities   Activity[]

  @@map("users")
}

model Student {
  id           Int               @id @default(autoincrement())
  stdCode      String            @unique @map("std_code")
  title        String?
  name         String
  faculty      String?
  program      String?
  centralHours Int               @default(0)
  facultyHours Int               @default(0)
  freeHours    Int               @default(0)
  histories    ActivityHistory[]
  qrcodes      QRCode[]

  @@map("tb_student")
}

model Activity {
  id                Int               @id @default(autoincrement())
  name              String
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  group             ActivityGroup     @default(CENTRAL)
  hours             Int               @default(1)
  location          String?
  organizer         String?
  status            ActivityStatus    @default(ACTIVE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdById       Int?
  createdBy         User?             @relation(fields: [createdById], references: [id])
  activityHistories ActivityHistory[]
  qrCodes           QRCode[]

  @@map("activities")
}

model QRCode {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  activityId  Int
  usedBy      Int?
  isUsed      Boolean           @default(false)
  usedAt      DateTime?
  expiredAt   DateTime?
  maxUses     Int               @default(1)
  currentUses Int               @default(0)
  type        QRType            @default(SINGLE_USE)
  createdAt   DateTime          @default(now())
  isActive    Boolean?          @default(true)
  histories   ActivityHistory[]
  activity    Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student     Student?          @relation(fields: [usedBy], references: [id])

  @@map("qr_codes")
}

model ActivityHistory {
  id          Int      @id @default(autoincrement())
  activityId  Int
  qrCodeId    Int
  studentId   Int
  scannedAt   DateTime @default(now())
  hoursEarned Int      @default(1)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  qrCode      QRCode   @relation(fields: [qrCodeId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([qrCodeId, studentId])
  @@map("activity_histories")
}

model FacultyRequirement {
  id         Int    @id @default(autoincrement())
  faculty    String @unique
  centralMin Int    @default(90)
  facultyMin Int    @default(90)
  freeMin    Int    @default(50)

  @@map("faculty_requirements")
}

model old_data {
  STUDENTCODE       String  @id @db.VarChar(50)
  STNAMETHAI        String? @db.VarChar(100)
  STNAMEENG         String? @db.VarChar(100)
  CITIZENID         String? @db.VarChar(100)
  PASSWORD          String? @db.VarChar(100)
  FACNAME           String? @db.VarChar(100)
  PROGRAMNAME       String? @db.VarChar(100)
  LEVELNAME         String? @db.VarChar(100)
  HOMEPHONENO       String? @db.VarChar(100)
  OFFICEPHONENO     String? @db.VarChar(100)
  STUDENTEMAIL      String? @db.VarChar(100)
  STUDENTSTATUSNAME String? @db.VarChar(100)
  STUDENTMAILSPARE  String? @db.VarChar(100)
  pass_status       Int     @default(0)

  @@map("old-data")
}

enum ActivityGroup {
  CENTRAL
  FACULTY
  FREE
}

enum QRType {
  SINGLE_USE
  MULTI_USE
  LIMITED_USE
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum UserRole {
  ADMIN
  EMPLOYEE
  STUDENT
}
