// schema.prisma - เรียบง่าย ใช้ users เป็นหลัก
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================= ENUMS =======================
enum ActivityGroup {
  CENTRAL    // กิจกรรมกลาง (Group 1)
  FACULTY    // กิจกรรมคณะ (Group 2)  
  FREE       // กิจกรรมเสรี (Group 3)
}

enum QRType {
  SINGLE_USE    // 1 QR ต่อ 1 คน
  MULTI_USE     // 1 QR ต่อหลายคน (ไม่จำกัด)
  LIMITED_USE   // 1 QR ต่อหลายคนแต่มีจำนวนจำกัด
}

enum ActivityStatus {
  ACTIVE
  INACTIVE 
  CANCELLED
}

enum UserRole {
  ADMIN
  EMPLOYEE
  STUDENT
}

// ======================= MODELS =======================

// ผู้ใช้งานระบบ - ตารางหลักเก็บข้อมูลทุก role
model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  name          String
  role          UserRole   @default(STUDENT)
  googleId      String?    @unique
  picture       String?
  title         String?       // คำนำหน้าชื่อ เช่น นาย, นางสาว
  faculty       String?       // คณะ
  program       String?       // สาขาวิชา (สำหรับนักศึกษา)
  department    String?       // ภาควิชา (สำหรับพนักงาน)
  stdCode       String?       // รหัสนักศึกษา
  empCode       String?       // รหัสพนักงาน
  centralHours  Int        @default(0)  // ชั่วโมงกิจกรรมกลาง
  facultyHours  Int        @default(0)  // ชั่วโมงกิจกรรมคณะ
  freeHours     Int        @default(0)  // ชั่วโมงกิจกรรมเสรี
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  // ความสัมพันธ์
  activities    Activity[] // กิจกรรมที่สร้าง

  @@map("users")
}

// ข้อมูลนักศึกษา - เก็บไว้สำหรับข้อมูลเพิ่มเติม (ไม่เชื่อมกับ users)
model Student {
  id        Int               @id @default(autoincrement())
  stdCode   String            @unique @map("std_code")
  title     String?
  name      String
  faculty   String?
  program   String?
  
  centralHours  Int           @default(0)
  facultyHours  Int           @default(0)
  freeHours     Int           @default(0)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  
  // ความสัมพันธ์
  qrcodes       QRCode[]
  histories     ActivityHistory[]

  @@map("tb_student")
}

// ข้อมูลกิจกรรม
model Activity {
  id                Int               @id @default(autoincrement())
  name              String
  description       String?
  startDate         DateTime?
  endDate           DateTime?
  group             ActivityGroup     @default(CENTRAL)
  hours             Int               @default(1)
  location          String?
  organizer         String?
  status            ActivityStatus    @default(ACTIVE)
  createdById       Int?              // อ้างอิงไปยัง users.id
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // ความสัมพันธ์
  createdBy         User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  qrCodes           QRCode[]
  activityHistories ActivityHistory[]

  @@map("activities")
}

// QR Code สำหรับใช้สแกนกิจกรรม
model QRCode {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  activityId  Int
  usedBy      Int?              // อ้างอิงไปยัง tb_student.id (ไม่ใช่ users.id)
  isUsed      Boolean           @default(false)
  isActive    Boolean           @default(true)  // เปิด/ปิด QR Code
  usedAt      DateTime?
  
  expiredAt   DateTime?
  maxUses     Int               @default(1)
  currentUses Int               @default(0)
  type        QRType            @default(SINGLE_USE)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  // ความสัมพันธ์
  activity    Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student     Student?          @relation(fields: [usedBy], references: [id], onDelete: SetNull)
  histories   ActivityHistory[]

  @@map("qr_codes")
}

// ประวัติการสแกนกิจกรรม
model ActivityHistory {
  id          Int       @id @default(autoincrement())
  activityId  Int
  qrCodeId    Int
  studentId   Int       // อ้างอิงไปยัง tb_student.id
  scannedAt   DateTime  @default(now())
  hoursEarned Int       @default(1)

  // ความสัมพันธ์
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  qrCode      QRCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([qrCodeId, studentId])
  @@map("activity_histories")
}

// ตารางสำหรับเก็บ requirement ของแต่ละคณะ
model FacultyRequirement {
  id          Int      @id @default(autoincrement())
  faculty     String   @unique
  centralMin  Int      @default(90)
  facultyMin  Int      @default(90)
  freeMin     Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("faculty_requirements")
}
